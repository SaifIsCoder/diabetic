# Diabetic Retinopathy API Environment Variables

# Service Port
PORT=5000

# Path to the trained Keras model artifact
RETINA_MODEL_PATH=retfound_model.keras

# Path to the quantized TFLite model artifact (Sprint 7 PERF-01)
RETINA_TFLITE_PATH=retfound_model.tflite
# Set USE_TFLITE=1 to enable high-throughput TFLite runtime, or 0 for standard Keras
USE_TFLITE=0

# Supabase Auth Secret
# Obtain from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
# If left empty, API operates in development mode (token verification bypassed)
SUPABASE_JWT_SECRET=

# Gunicorn concurrency settings (Production container - Sprint 7/8 PR-07 & PR-04)
# Default sizing: 2 workers x 4 threads = 8 concurrent request slots minimum
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
LOG_LEVEL=info

# Google Gemini API - Fundus Image Pre-validation Gate
# Secure server-side API Key (obtain from https://aistudio.google.com/)
# NEVER expose this key in client-side code or EXPO_PUBLIC_* variables.
# SECURITY NOTICE (PR-08 Remediation):
# The previously exposed key ending in '...P9rw' has been revoked. Rotate any keys
# exposed prior to this fix. In production, load via Secret Manager or container environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ENABLE_GEMINI_VALIDATION=true
GEMINI_TIMEOUT_SECONDS=15

# Security, CORS & Rate Limiting (Sprint 1 Remediations SEC-02, SEC-03, SEC-07, ARCH-01)
# Comma-separated list of allowed origins (CORS)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5000,http://127.0.0.1:8081,http://127.0.0.1:19006,http://127.0.0.1:3000,http://127.0.0.1:5000
RATE_LIMIT_PREDICT=10 per minute
RATE_LIMIT_HEALTH=60 per minute
RATE_LIMIT_VERIFY=30 per minute
# Cryptographic secret for signing tamper-evident scan receipts (ARCH-01)
# Defaults to SUPABASE_JWT_SECRET if left empty
SCAN_HMAC_SECRET=
